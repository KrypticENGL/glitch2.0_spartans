{
  "name": "suraksha-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "node scripts/db.mjs migrate",
    "seed": "node scripts/db.mjs seed",
    "db:reset": "node scripts/db.mjs reset",
    "seed:demo": "tsx src/scripts/seed-demo.ts",
    "seed:demo:prod": "node dist/scripts/seed-demo.js",
    "openapi:generate": "tsx src/scripts/generate-openapi.ts && openapi-typescript ../shared/openapi/openapi.json -o ../shared/openapi/types.ts",
    "db:setup": "node scripts/db.mjs migrate && node scripts/db.mjs seed && npm run seed:demo:prod",
    "demo": "node scripts/demo-e2e.mjs"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "socket.io": "^4.8.4",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@electric-sql/pglite-postgis": "^0.2.17",
    "@electric-sql/pglite-socket": "^0.2.20",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "openapi-typescript": "^7.13.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22"
  }
}
